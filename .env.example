# Kronos Trader — Required Secrets
# Add these to GitHub Actions → Settings → Secrets → Actions

# Twelve Data API Keys (JSON array of 8 keys)
TWELVE_DATA_KEYS=["your_key_1","your_key_2","your_key_3","your_key_4","your_key_5","your_key_6","your_key_7","your_key_8"]

# Alpaca Paper Trading
KRONOS_ALPACA_KEY_ID=your_alpaca_key
KRONOS_ALPACA_SECRET_KEY=your_alpaca_secret

# Email (Gmail SMTP)
KRONOS_EMAIL=your_email@gmail.com
KRONOS_EMAIL_PASSWORD=your_app_password
KRONOS_RECIPIENT=your_recipient@gmail.com

# Optional: Path to cloned Kronos repo (default: /tmp/kronos_repo)
# KRONOS_REPO=/tmp/kronos_repo

# Optional: Send email report (default: true, set to false for pre-market runs)
# KRONOS_SEND_EMAIL=true
